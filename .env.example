# Copy to .env for local overrides. Every setting in src/infrastructure/config/settings.py maps to an upper-case variable of the same name.
DATABASE_URL=postgresql+psycopg://ezra_admin:ezra_admin_pass@localhost:5433/ezra_lms
AUTH_JWT_SECRET=change-me-in-prod-change-me-in-prod
AUTH_JWT_ISSUER=lms-api
AUTH_JWT_CLOCK_SKEW_SECONDS=60
NOTIFICATIONS_KAFKA_ENABLED=true
NOTIFICATIONS_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEDULING_ENABLED=true
PENALTY_DAILY_RATE=0.001
LOAN_DEFAULT_AFTER_DAYS_PAST_DUE=90
REMINDER_DAYS_BEFORE_DUE=3
